{
  "name": "statecraft-web-server",
  "version": "2.0.0",
  "description": "Web-based multiplayer Diplomacy game with database persistence and smart bot players",
  "main": "server-db.js",
  "scripts": {
    "start": "node server-db.js",
    "dev": "nodemon server-db.js",
    "migrate": "node database/migrate.js",
    "db:setup": "createdb statecraft && npm run migrate"
  },
